# CI validation image — builds app and includes test dependencies (Playwright deps installed)
FROM node:18-slim
WORKDIR /app

# Install OS deps required by Playwright/browser tests (minimal set)
RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    ca-certificates \
    fonts-liberation \
    libasound2 \
    libatk-bridge2.0-0 \
    libatk1.0-0 \
    libcups2 \
    libdbus-1-3 \
    libdrm2 \
    libgbm1 \
    libgtk-3-0 \
    libx11-6 \
    libx11-xcb1 \
    libxcomposite1 \
    libxrandr2 \
    libxdamage1 \
    libxfixes3 \
    libxkbcommon0 \
    libxss1 \
  && rm -rf /var/lib/apt/lists/*

# Install node deps
COPY package*.json ./
RUN npm ci --no-fund --no-audit

# Copy source
COPY . .

# Install Playwright browsers and OS deps (ensures playwright tests can run inside image)
RUN npx playwright install --with-deps || true

# Build app for validation
RUN npm run build

# Default: keep container available for `docker run` test commands
CMD ["/bin/sh"]
