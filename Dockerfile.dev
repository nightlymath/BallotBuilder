# Dev Dockerfile for BallotBuilder — bind-mount friendly (hot-reload)
FROM node:18-slim
WORKDIR /app
ENV NODE_ENV=development

# Install deps (including devDeps for hot-reload/test tooling)
COPY package*.json ./
RUN npm ci --no-fund --no-audit

# Copy source to allow image to run without mounts (mounting is recommended)
COPY . .

EXPOSE 3000
# Use CHOKIDAR polling on Windows by setting CHOKIDAR_USEPOLLING env when running container
CMD ["npm", "run", "dev"]
